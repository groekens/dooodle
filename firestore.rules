rules_version = '2';

// Dooodle : les participants n'ont pas de compte, la sécurité repose sur quatre principes.
// 1. On peut lire un sondage dont on connaît l'ID. Seul son organisateur peut le retrouver
//    par une requête (page "Mes sondages").
// 2. N'importe qui peut ajouter ou corriger UN vote à la fois, tant que le sondage est ouvert.
// 3. L'organisateur (ownerUid, posé à la création) peut annoncer une date, rouvrir,
//    céder ou supprimer son sondage. Un sondage sans ownerUid n'a pas d'organisateur.
// 4. Personne d'autre ne peut modifier le titre, les dates ou supprimer quoi que ce soit.
//
// Le client écrit le prénom du votant dans `lastVoter` en même temps que son vote :
// les règles ne savent pas itérer une map, ce champ leur indique quelle clé vérifier.
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    // Un vote = { 'AAAA-MM-JJ': 'yes' | 'maybe' }, uniquement sur des dates du sondage.
    function isValidVote(v, dates) {
      return v is map
        && v.keys().hasOnly(dates)
        && v.values().hasOnly(['yes', 'maybe']);
    }

    function isOwner(poll) {
      return request.auth != null && poll.get('ownerUid', null) == request.auth.uid;
    }

    match /polls/{pollId} {
      allow get: if true;
      // Une requête n'est acceptée que si elle filtre sur ownerUid == l'utilisateur connecté
      allow list: if isOwner(resource.data);
      allow delete: if isOwner(resource.data);

      allow create: if
        request.resource.data.keys().hasOnly(['slug', 'title', 'dates', 'votes', 'createdAt', 'lastVoter', 'ownerUid'])
        && request.resource.data.slug == pollId
        && pollId.size() <= 64
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.dates is list
        && request.resource.data.dates.size() >= 2
        && request.resource.data.dates.size() <= 60
        && request.resource.data.createdAt is string
        && (!('ownerUid' in request.resource.data) || isOwner(request.resource.data))
        && request.resource.data.votes is map
        && (
          request.resource.data.votes.size() == 0
          || (
            isValidName(request.resource.data.lastVoter)
            && request.resource.data.votes.keys().hasOnly([request.resource.data.lastVoter])
            && isValidVote(request.resource.data.votes[request.resource.data.lastVoter], request.resource.data.dates)
          )
        );

      // Vote d'un participant : sondage ouvert, un seul vote touché
      allow update: if
        resource.data.get('closed', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'lastVoter'])
        && isValidName(request.resource.data.lastVoter)
        && request.resource.data.votes is map
        && request.resource.data.votes.size() <= 200
        && request.resource.data.votes.diff(resource.data.votes).affectedKeys()
             .hasOnly([request.resource.data.lastVoter])
        && request.resource.data.lastVoter in request.resource.data.votes
        && isValidVote(request.resource.data.votes[request.resource.data.lastVoter], resource.data.dates);

      // Organisateur : annoncer une date (closed + finalDate, heure finalTime facultative "HH:MM"),
      // changer l'heure d'une date annoncée, ou rouvrir (closed = false)
      allow update: if
        isOwner(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed', 'finalDate', 'finalTime'])
        && request.resource.data.closed is bool
        && (
          (request.resource.data.closed == true && request.resource.data.finalDate in resource.data.dates
            && (!('finalTime' in request.resource.data)
                || (request.resource.data.finalTime is string
                    && request.resource.data.finalTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))))
          || (request.resource.data.closed == false && !('finalDate' in request.resource.data)
              && !('finalTime' in request.resource.data))
        );

      // Organisateur : céder le sondage à un autre compte (rattachement anonyme vers Google)
      allow update: if
        isOwner(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() >= 1
        && request.resource.data.ownerUid.size() <= 128;
    }
  }
}
